{
  "name": "daily-work-notes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "vitest run",
    "lint": "prettier --check src e2e *.ts *.json && ng build --configuration development",
    "format": "prettier --write src e2e *.ts *.json",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/material": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
